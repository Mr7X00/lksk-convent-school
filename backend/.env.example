# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local: mongodb://127.0.0.1:27017/lksk_school
# Cloud (Atlas): mongodb+srv://<username>:<password>@cluster.mongodb.net/lksk_school?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lksk_school

# Client CORS Configuration & Public Canonical Domain
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
TRUST_PROXY=1

# Security & Authentication (JWT Secret)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Configuration
ADMIN_INITIAL_NAME=Lav Pandey
ADMIN_INITIAL_USERNAME=lavpandey
ADMIN_INITIAL_EMAIL=lkskconventschool@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_secure_admin_password

# Email Notification Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="L.K.S.K Convent School" <noreply@lkskschool.edu.in>
MAIL_TO=lkskconventschool@gmail.com

