# ====================================================
# L.K.S.K Convent School - Environment Variables Guide
# ====================================================
# Institution: L.K.S.K Convent School, Ayodhya
# Developer/Admin: Lav Pandey

# ----------------------------------------------------
# 1. Backend Configuration (backend/.env)
# ----------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/lksk_school
# Cloud (Atlas): mongodb+srv://<username>:<password>@cluster.mongodb.net/lksk_school?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lksk_school

# Client Origin (CORS allowlist) & Public Canonical URL (Sitemap/Robots)
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Reverse Proxy Trust (1 when deployed behind Nginx, Caddy, Cloudflare, AWS ALB)
TRUST_PROXY=1

# Security & Authentication (JWT Secret)
# Generate in production using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Profile (Used by `npm run seed:admin`)
ADMIN_INITIAL_NAME=Lav Pandey
ADMIN_INITIAL_USERNAME=lavpandey
ADMIN_INITIAL_EMAIL=lkskconventschool@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_secure_admin_password

# Email Notification Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="L.K.S.K Convent School" <lkskconventschool@gmail.com>
MAIL_TO=lkskconventschool@gmail.com

# ----------------------------------------------------
# 2. Frontend Configuration (frontend/.env)
# ----------------------------------------------------
VITE_API_BASE_URL=/api
